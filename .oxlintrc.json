{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "options": { "typeAware": true },
  "ignorePatterns": ["dist/**", ".agents/skills/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": ["error", { "ignoreVoid": false }],
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/label-has-associated-control": "error"
  },
  "overrides": [
    {
      "files": ["src/modules/**/*.ts", "src/patch/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "@strudel/*",
                  "**/strudel/**"
                ],
                "message": "Keep domain modules pure; access React/audio through the app or engine adapter."
              }
            ]
          }
        ]
      }
    }
  ]
}
