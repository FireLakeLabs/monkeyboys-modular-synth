{
  "name": "monkeyboys-modular-synth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-strudel-audio-pools.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:runtime && npm run format:check && npm run check:skills && npm run lint && npm test && npm run coverage:reader && npm run test:guardrails && npm run build",
    "check:runtime": "node scripts/check-runtime.mts",
    "check:skills": "node scripts/check-skills.mts",
    "test:guardrails": "node --test scripts/*.test.mts",
    "coverage:reader": "node scripts/reader-coverage.mjs",
    "coverage:reader:wild": "node scripts/reader-coverage.mjs --wild"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@strudel/web": "^1.3.0",
    "acorn": "^8.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk": "2.1147.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.6.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  }
}
