setcpm(120/4)

$: s("[bd ~]*4, [~ ~ sd ~]*2, [~ hh]*4")
  .degradeBy(0.1)
  .bank("RolandTR909")
  .speed(1.1)
  .gain(0.35)
  .postgain(0.8)
  .orbit(1)

