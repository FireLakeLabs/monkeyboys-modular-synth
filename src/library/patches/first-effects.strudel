setcpm(120/4)

$: note("c3 e3 g3 b3")
  .s("sawtooth")
  .lpf(800)
  .lpq(1)
  .gain(0.2)
  .room(0.25)
  .roomsize(4)
  .postgain(0.8)
  .orbit(1)

