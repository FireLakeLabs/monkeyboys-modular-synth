setcpm(120/4)

$: note("c3 e3 g3 b3")
  .s("sine")
  .chunk(4, x => x.ply("2").rev())
  .firstOf(4, x => x.rev())
  .sometimesBy(0.5, x => x.iter(3))
  .off(0.125, x => x.gain(0.5))
  .superimpose(x => x.rev())
  .within(0.25, 0.75, x => x.rev())
  .jux(x => x.ply("2").rev())
  .gain(0.1)
  .orbit(1)

