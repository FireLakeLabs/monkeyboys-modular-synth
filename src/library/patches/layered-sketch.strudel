setcpm(118/4)

$: note("c2 ~ c2 g2")
  .s("sawtooth")
  .lpf(700)
  .lpq(1)
  .gain(0.2)
  .postgain(0.8)
  .orbit(1)

$: note("c4 eb4 g4 bb4")
  .s("triangle")
  .gain(0.15)
  .postgain(0.6)
  .orbit(2)

$: s("bd*4, [~ hh]*4")
  .bank("RolandTR808")
  .gain(0.25)
  .postgain(0.7)
  .orbit(3)

