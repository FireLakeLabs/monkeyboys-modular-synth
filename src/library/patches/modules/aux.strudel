setcpm(120/4)

$: s("bus").n(1)
  .lpf(900)
  .lpq(1)
  .postgain(0.15)
  .orbit(1)

$: note("c3*4")
  .s("sine")
  .bus(1)
  .dry(0).delay(0).room(0)
  .orbit(2)

$: note("e3*4")
  .s("sine")
  .bus(1)
  .dry(0).delay(0).room(0)
  .orbit(3)

