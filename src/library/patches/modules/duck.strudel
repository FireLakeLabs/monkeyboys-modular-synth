setcpm(120/4)

const trigger = note("c1*4")
  .s("sine")

$: trigger
  .postgain(0.15)
  .orbit(1)

$: note("c3")
  .s("sine")
  .postgain(0.1)
  .orbit(2)

$: trigger
  .duck(2).duckattack(0.2).duckdepth(0.8)
  .dry(0).delay(0).room(0)
  .orbit(3)

