setcpm(120/4)

$: stack(note("c3 ~ g3 ~"), note("~ e3 ~ b3")).s("sine").gain(0.15).postgain(0.8).orbit(1)

$: note("c2*4")
  .s("triangle")
  .gain(0.1)
  .postgain(0.6)
  .orbit(2)

