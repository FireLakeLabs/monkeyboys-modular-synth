setcpm(120/4)

const voice_seq1 = note("c3")

const voice_seq2 = note("d3")

const voice_seq3 = note("e3")

const voice_seq4 = note("f3")

$: "<0 0 1 2>".pick([voice_seq1, voice_seq2, voice_seq3, voice_seq4])
  .s("sine")
  .postgain(0.15)
  .orbit(1)

