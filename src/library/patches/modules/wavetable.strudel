samples('https://raw.githubusercontent.com/bubobubobubobubo/dough-waveforms/125801fa9a799117fd0a0350a195ab7c2f4cdf13/strudel.json', 'https://raw.githubusercontent.com/bubobubobubobubo/dough-waveforms/125801fa9a799117fd0a0350a195ab7c2f4cdf13/');
setcpm(120/4)

$: note("c3 e3 g3 c4")
  .s("wt_dbass:0")
  .wt(0.4)
  .warp(0.2)
  .warpmode("spin")
  .gain(0.15)
  .postgain(0.8)
  .orbit(1)

