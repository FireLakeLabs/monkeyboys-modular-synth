setcpm(120/4)

$: note("<c3 d3 e3 f3> [g3 a3] bb3 c4")
  .rev()
  .shuffle(8)
  .rib(45, 2)
  .zoom(0.25, 0.75)
  .brak()
  .echo(3, 0.125, 0.5)
  .s("sine")
  .gain(0.15)
  .orbit(1)

