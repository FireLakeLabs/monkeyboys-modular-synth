setcpm(120/4)

$: chord("<Cm7 Fm7 G7>")
  .voicing()
  .arp("0 1 2 1")
  .s("sine")
  .gain(0.15)
  .orbit(1)

$: note("c3")
  .euclidRot(3, 8, 2)
  .ply("<1 2 4>")
  .degradeBy(0.3)
  .seed(45)
  .slow(2)
  .swingBy(1/3, 4)
  .late(0.125)
  .s("triangle")
  .gain(0.15)
  .orbit(2)

