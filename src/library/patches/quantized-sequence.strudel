setcpm(108/4)

$: n("0 2 4 <6 7> 4 2 1 ~")
  .fast(2)
  .scale("D:dorian")
  .s("triangle")
  .transpose(-12)
  .gain(0.3)
  .postgain(0.8)
  .orbit(1)

