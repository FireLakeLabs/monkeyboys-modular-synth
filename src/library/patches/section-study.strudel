// @title Changing rooms
// @by MonkeyBoy’s Modular Synth contributors
// @license MIT


setcpm(120/4)

const pulse = note("<c3 e3 g3>")
  .s("triangle")
  .gain(0.08)

const upper = note("c4 e4 g4 b4")
  .s("sine")
  .gain(0.05)

$: arrange([2, pulse], [1, stack(pulse, upper)], [3, upper], [1.5, pulse
  .rev()], [0.5, stack(pulse, upper)]).room(0.15).roomsize(0.6).orbit(1)

