setcpm(120/4)

$: s("crackle")
  .density(0.1)
  .gain(0.05)
  .orbit(1)

$: note("c3 e3 g3")
  .s("user")
  .partials([1,0.5,0,0.3])
  .gain(0.1)
  .orbit(2)

$: note("c2*4")
  .s("sine")
  .fm(2)
  .fmh(1.5)
  .fmattack(0.01)
  .fmdecay(0.3)
  .soft(0.5)
  .fold(0.6)
  .crush(6)
  .coarse(4)
  .vowel("<a e i o>")
  .compressor("-20:4:10:.005:.1")
  .transient(0.5)
  .phaser(2)
  .phaserdepth(0.5)
  .pan(0.3)
  .stretch(1.5)
  .gain(0.05)
  .orbit(3)

