  .slow(6)
  .s("sawtooth")
  .lpf(720)
  .lpq(0.5)
  .lpenv(2)
  .lpattack(0.02)
  .lpdecay(0.7)
  .lpsustain(0.6)
  .lprelease(0.1)
  .soft(2.5)
  .attack(0.02)
  .decay(0.7)
  .sustain(0.6)
  .release(0.1)
  .gain(0.9)
  .postgain(0.25)
  .orbit(1)

low: note("e2@9 ~@3 d2@9 ~@3 e2@9 ~@3 d2@9 ~@3")
