  .slow(6)
  .s("square")
  .attack(0.01)
  .decay(0.2)
  .sustain(0.75)
  .release(0.05)
  .gain(0.18)
  .postgain(0.8)
  .orbit(1)

afterimage: note("~@9 b4 ~@11 a4 ~@11 e4 ~@11 a4 ~@2")
  .velocity("0.7")
  .slow(6)
  .s("triangle")
  .bpf(650)
  .bpq(2)
  .bpenv(1)
  .bpattack(0.01)
  .bpdecay(0.2)
  .bpsustain(0)
