  .attack(0.01)
  .decay(0.2)
  .sustain(0)
  .release(0.15)
  .gain(0.8)
  .pan(0.6)
  .delay(0.2)
  .delayfeedback(0.25)
  .delaysync(0.125)
  .postgain(0.6)
  .orbit(2)

low: note("e2@10 ~@2 d2@10 e2@12 ~@2 d2@10 e2@2")
