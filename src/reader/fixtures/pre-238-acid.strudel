$: note("c2*16").add("[0, 0, 12, 0, 3, 0, 5, 0, 0, 12, 0, 7, 0, 3, 0, 12]").s("saw")
  .cutoff(perlin.range(200, 1500).slow(4)).resonance(25).gain(0.6).room(0.15)
